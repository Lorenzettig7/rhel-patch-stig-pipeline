---
skip_list:
  # rhel_patch uses the short `patch_` prefix for its variables by design.
  - var-naming[no-role-prefix]
exclude_paths:
  - evidence/
  - reports/
  # Vendored, unmodified SSG-generated STIG playbooks (CM-2 baseline). Linting
  # them would mean editing generated Red Hat content.
  - remediation/
